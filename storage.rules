rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /drivers/ktp/{allPaths=**} {
      allow read, write: if true;
    }
    match /drivers/sim/{allPaths=**} {
      allow read, write: if true;
    }
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
